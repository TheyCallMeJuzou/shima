<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Duplicate entries without "android" namespace are for AppCompat,
         to be compatible with Android Design Support Library -->

    <style name="Base.AppTheme" parent="Base.Shima">     <!-- Colour roles in shared/res/values/styles.xml -->
        <item name="android:statusBarColor">?attr/colorSurfaceContainer</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:alertDialogTheme">@style/Shima.FrameworkDialog.Alert</item>
        <item name="preferenceTheme">@style/ThemeOverlay.Shima.Preference</item>
    </style>

    <!-- Framework AlertDialog (used by deagle's Dialogs) dressed as a Material 3 dialog -->
    <style name="Base.Shima.FrameworkDialog" parent="android:Theme.Material.Light.Dialog.Alert" />
    <style name="Shima.FrameworkDialog.Alert" parent="Base.Shima.FrameworkDialog">
        <item name="android:windowBackground">@drawable/dialog_background_m3</item>
        <item name="android:colorBackground">?attr/colorSurfaceContainerHigh</item>
        <item name="android:colorAccent">?attr/colorPrimary</item>
        <item name="android:textColorPrimary">?attr/colorOnSurface</item>
        <item name="android:textColorSecondary">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- AndroidX Preference: no reserved icon space, Material 3 switches -->
    <style name="ThemeOverlay.Shima.Preference" parent="PreferenceThemeOverlay">
        <item name="preferenceStyle">@style/Shima.Preference</item>
        <item name="preferenceCategoryStyle">@style/Shima.Preference.Category</item>
        <item name="checkBoxPreferenceStyle">@style/Shima.Preference.CheckBox</item>
        <item name="switchPreferenceCompatStyle">@style/Shima.Preference.Switch</item>
        <item name="editTextPreferenceStyle">@style/Shima.Preference.EditText</item>
    </style>
    <style name="Shima.Preference" parent="Preference.Material"><item name="iconSpaceReserved">false</item></style>
    <style name="Shima.Preference.Category" parent="Preference.Category.Material"><item name="iconSpaceReserved">false</item></style>
    <style name="Shima.Preference.CheckBox" parent="Preference.CheckBoxPreference.Material"><item name="iconSpaceReserved">false</item></style>
    <style name="Shima.Preference.Switch" parent="Preference.SwitchPreferenceCompat.Material">
        <item name="iconSpaceReserved">false</item>
        <item name="android:widgetLayout">@layout/preference_material_switch</item>
    </style>
    <style name="Shima.Preference.EditText" parent="Preference.DialogPreference.EditTextPreference.Material"><item name="iconSpaceReserved">false</item></style>

    <style name="AppTheme.NoActionBar" parent="Base.AppTheme" />

    <style name="AppTheme.Settings" parent="Base.AppTheme" />    <!-- Toolbar from layout/activity_settings.xml -->

    <style name="AppTheme.BorderlessActionButton" parent="android:Widget.Material.Button.Borderless.Colored">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/margin_small</item>
        <item name="android:layout_marginEnd">@dimen/margin_small</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:gravity">start</item>
    </style>

    <!-- Setup Wizard -->
    <style name="SetupTheme" parent="SuwThemeMaterial.Light">
        <!--<item name="android:windowTranslucentStatus">true</item>-->
        <item name="android:colorAccent">@color/accent</item>
        <item name="suwLayoutTheme">@style/SetupIllustrationTheme</item>
    </style>
    <style name="SetupIllustrationTheme">
        <item name="suwBackground">@drawable/setup_header</item>
        <!--<item name="suwIllustrationAspectRatio">2</item>-->
        <!--<item name="suwIllustration">@drawable/setup_header</item>-->
        <!--<item name="suwDecorPaddingTop">@dimen/suw_decor_padding_top</item>-->
    </style>
    <style name="contentContainer">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:paddingBottom">@dimen/content_padding_bottom</item>
        <item name="android:paddingStart">@dimen/content_padding_start_end</item>
        <item name="android:paddingEnd">@dimen/content_padding_start_end</item>
        <item name="android:paddingTop">@dimen/content_padding_top</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
        <item name="android:textSize">@dimen/content_text_size</item>
    </style>
    <style name="containerText">
        <item name="android:textSize">@dimen/content_text_size</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>


</resources>
